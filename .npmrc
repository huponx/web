# @huponx/protogen (the permission constants) is published to GitHub Packages by the generate workflow of protogen.
# NODE_AUTH_TOKEN: a token with read:packages (in CI the job token, locally `export NODE_AUTH_TOKEN=$(gh auth token)`).
@huponx:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
